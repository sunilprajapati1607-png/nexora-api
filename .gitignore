# Nexora API — what never goes into this repository
# ----------------------------------------------------------------------
# The service has no runtime dependencies; node_modules appears only when
# CI installs the build tools for the Edge Function.
node_modules/

# The Edge Function bundle is GENERATED by api/build-edge.mjs from
# api/edge/ and api/src/, and rebuilt by the deploy workflow every time.
# A copy committed here could only ever be stale.
api/supabase/

# Secrets are environment variables on Render and function secrets on
# Supabase. None of them belong here.
.env
.env.*
.secrets.json
.secrets.*.json
